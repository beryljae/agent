<!DOCTYPE html>
<html>
<head>
  <title>BerylOnChain | AI Agent</title>
  <style>
    body { background-color: #0d1117; color: #00ffff; font-family: monospace; padding: 20px; max-width: 800px; margin: auto; }
    h1 { color: #fff; border-bottom: 2px solid #00ffff; padding-bottom: 10px; }
    label { font-size: 14px; font-weight: bold; margin-top: 15px; display: block; color: #fff; }
    textarea, input { width: 100%; background: #161b22; color: #00ffff; border: 1px solid #00ffff; padding: 12px; margin-top: 5px; border-radius: 5px; box-sizing: border-box; font-family: monospace; }
    button { background: #00ffff; color: #000; border: none; padding: 15px 30px; margin-top: 20px; cursor: pointer; font-weight: bold; font-size: 16px; border-radius: 5px; width: 100%; text-transform: uppercase; }
    button:hover { background: #fff; color: #000; }
    #output { background: #161b22; padding: 20px; white-space: pre-wrap; margin-top: 20px; border: 1px solid #333; border-radius: 5px; color: #c9d1d9; line-height: 1.6; min-height: 200px; }
  </style>
</head>
<body>
  <h1>🤖 BERYLONCHAIN PUBLISHING AGENT</h1>
  
  <label>1. PASTE YOUR API KEY HERE:</label>
  <input type="password" id="apiKey" placeholder="Paste the Google API key...">
  
  <label>2. WHAT IS THE TOPIC?</label>
  <input type="text" id="topic" placeholder="e.g., How to start a Web3 side hustle in 2026...">
  
  <button onclick="generateArticle()">🚀 Research & Write Article</button>
  
  <div id="output">Your beautifully formatted markdown article will appear here...</div>

  <script>
    async function generateArticle() {
      const apiKey = document.getElementById('apiKey').value;
      const topic = document.getElementById('topic').value;
      const output = document.getElementById('output');
      
      if(!apiKey || !topic) {
         output.innerText = "⚠️ ERROR: Please paste your API key and type a topic!";
         return;
      }
      
      output.innerText = "⏳ Accessing the live web... Writing your article... Please wait a few seconds...";

      const prompt = `You are writing an article for the BULB platform under the handle BerylOnChain. 
      Topic: ${topic}. 
      Style: Authoritative on Web3 and digital side hustles. 
      Formatting: Output strictly in clean Markdown ready for publishing. Bold key concepts. Suggest a visual image prompt at the very top for a dark-mode cyberpunk aesthetic header image.`;

      const requestBody = {
        contents: [{ parts: [{ text: prompt }] }],
        tools: [{ googleSearch: {} }]
      };

      try {
        const response = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=' + apiKey, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });
        
        const data = await response.json();
        output.innerText = data.candidates[0].content.parts[0].text;
      } catch (error) {
        output.innerText = "⚠️ ERROR: " + error.message;
      }
    }
  </script>
</body>
</html>
